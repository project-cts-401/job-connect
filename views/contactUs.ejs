<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.8/css/line.css">

    <link rel="stylesheet" href="/home/assets/css/style.css">
    <link rel="stylesheet" href="/css/contact.css"> <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" xintegrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />

    <link rel="shortcut icon" href="/images/favicon.png" type="image/x-icon">
    <title>job-connect | Contact Us</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Minimal inline styles, prefer contact.css for extensive styling */
        body {
            font-family: 'Poppins', sans-serif; /* Consistent font from home */
        }
    </style>
</head>

<body id="top">

    <!--
      - #HEADER
    -->
    <header class="header" data-header>
        <div class="container">
            <a href="/" class="logo">
                <ion-icon name="business-outline"></ion-icon> job-connect
            </a>
            <nav class="navbar container" data-navbar>
                <ul class="navbar-list">
                    <li><a href="/" class="navbar-link" data-nav-link>Home</a></li>
                    <li><a href="/AboutUs" class="navbar-link" data-nav-link>About Us</a></li>
                    <li><a href="/contactUs" class="navbar-link" data-nav-link style="color: hsl(194, 100%, 28%);">Contact Us</a></li>
                    <li><a href="/jobs" class="navbar-link" data-nav-link>Jobs</a></li>
                    <% if (locals.session && locals.session.role) { %>
                        <% if (locals.session.role === 'student') { %>
                            <li><a href="/applications/my" class="navbar-link" data-nav-link>My Applications</a></li>
                        <% } else if (locals.session.role === 'admin') { %>
                            <li><a href="/admin/jobs" class="navbar-link" data-nav-link>My Postings</a></li>
                            <li><a href="/admin/jobs/new" class="navbar-link" data-nav-link>Post New Job</a></li>
                        <% } %>
                    <% } %>
                </ul>
            </nav>
            <% if (locals.session && locals.session.userId) { %>
                <a href="/auth/logout" class="btn btn-secondary">Logout</a>
            <% } else { %>
                <a class="btn btn-secondary" href="/auth/login">Login</a>
            <% } %>
            <button class="nav-toggle-btn" aria-label="Toggle menu" data-nav-toggler>
                <ion-icon name="menu-outline" aria-hidden="true" class="menu-icon"></ion-icon>
                <ion-icon name="close-outline" aria-hidden="true" class="close-icon"></ion-icon>
            </button>
        </div>
    </header>

    <main>
        <article class="article">

            <!--
              - #CONTACT HERO
            -->
            <section class="section contact-hero" aria-label="Contact Us Hero">
                <div class="container">
                    <div class="contact-hero-content">
                        <h1 class="h1 hero-title">Get in <span class="span">Touch</span></h1>
                        <p class="hero-text">
                            We're here to help! Whether you have a question about Job-Connect, need support, or want to provide feedback, please don't hesitate to reach out to us.
                        </p>
                    </div>
                </div>
            </section>

            <!--
              - #CONTACT DETAILS & FORM
            -->
            <section class="section contact-main" aria-label="Contact Details and Form">
                <div class="container">
                    <div class="contact-grid">
                        <div class="contact-info">
                            <h2 class="h2 section-title-sub">Contact Information</h2>
                            <p class="section-text">
                                You can reach the Job-Connect support team or relevant UMP offices through the following channels:
                            </p>
                            <ul class="contact-details-list">
                                <li>
                                    <div class="contact-item-icon"><i class="ri-map-pin-line"></i></div>
                                    <div class="contact-item-content">
                                        <h3 class="h3 contact-item-title">Main Campus Address</h3>
                                        <address>
                                            University of Mpumalanga<br>
                                            Cnr R40 and D725 Roads, Mbombela 1200<br>
                                            Mpumalanga Province, South Africa
                                        </address>
                                    </div>
                                </li>
                                <li>
                                    <div class="contact-item-icon"><i class="ri-mail-send-line"></i></div>
                                    <div class="contact-item-content">
                                        <h3 class="h3 contact-item-title">Job-Connect Support Email</h3>
                                        <a href="mailto:jobconnect.support@ump.ac.za" class="contact-link">jobconnect.support@ump.ac.za</a>
                                        <p class="contact-note">(For platform technical issues & general inquiries)</p>
                                    </div>
                                </li>
                                <li>
                                    <div class="contact-item-icon"><i class="ri-phone-line"></i></div>
                                    <div class="contact-item-content">
                                        <h3 class="h3 contact-item-title">UMP Student Enquiries</h3>
                                        <a href="tel:+27130020001" class="contact-link">+27 (13) 002 0001</a>
                                        <p class="contact-note">(For general student-related matters)</p>
                                    </div>
                                </li>
                                 <li>
                                    <div class="contact-item-icon"><i class="ri-building-4-line"></i></div>
                                    <div class="contact-item-content">
                                        <h3 class="h3 contact-item-title">UMP Career Services</h3>
                                         <p>Contact Career Services directly for CV workshops, interview skills, etc. (Details available on the main UMP website)</p>
                                    </div>
                                </li>
                                <li>
                                    <div class="contact-item-icon"><i class="ri-time-line"></i></div>
                                    <div class="contact-item-content">
                                        <h3 class="h3 contact-item-title">Support Hours</h3>
                                        <p>Monday - Friday: 08:00 AM - 04:30 PM (SAST)</p>
                                        <p class="contact-note">Closed on weekends and public holidays.</p>
                                    </div>
                                </li>
                            </ul>
                        </div>

                        <div class="contact-form-container">
                            <h2 class="h2 section-title-sub">Send Us a Message</h2>
                            <p class="section-text">
                                Fill out the form below, and our team will get back to you as soon as possible.
                            </p>
                            <% if (locals.message) { %>
                                <div class="form-message <%= message.type %>">
                                    <%= message.text %>
                                </div>
                            <% } %>
                            <form action="/contactUs/send" method="POST" class="contact-form hero-form">
                                <div class="input-wrapper">
                                    <label for="name" class="input-label">Full Name:</label>
                                    <input type="text" name="name" id="name" placeholder="Enter your full name" class="input-field" required
                                    value="<%= locals.formData && formData.name ? formData.name : (locals.session && locals.session.userName ? locals.session.userName : '') %>">
                                </div>
                                <div class="input-wrapper">
                                    <label for="email" class="input-label">Email Address:</label>
                                    <input type="email" name="email" id="email" placeholder="Enter your email address" class="input-field" required
                                    value="<%= locals.formData && formData.email ? formData.email : (locals.session && locals.session.userEmail ? locals.session.userEmail : '') %>">
                                </div>
                                <div class="input-wrapper">
                                    <label for="subject" class="input-label">Subject:</label>
                                    <input type="text" name="subject" id="subject" placeholder="What is your message about?" class="input-field" required
                                    value="<%= locals.formData && formData.subject ? formData.subject : '' %>">
                                </div>
                                <div class="input-wrapper">
                                    <label for="message" class="input-label">Message:</label>
                                    <textarea name="message" id="message" rows="6" placeholder="Write your message here..." class="input-field textarea-field" required><%= locals.formData && formData.message ? formData.message : '' %></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary form-submit-btn">Send Message <i class="ri-send-plane-fill"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </section>

            <!--
              - #MAP SECTION
            -->
            <section class="section contact-map" aria-label="Our Location">
                <div class="container">
                    <h2 class="h2 section-title">Find Us on Campus</h2>
                    <div class="map-responsive">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3603.033548627583!2d30.981775600000002!3d-25.4371419!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1ee835ddde836b49%3A0xfe875f0851caa5cf!2sUniversity%20of%20Mpumalanga!5e0!3m2!1sen!2sza!4v1748436689306!5m2!1sen!2sza" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                </div>
            </section>

            <!--
              - #FAQ SECTION
            -->
            <section class="section faq-section" aria-label="Frequently Asked Questions">
                <div class="container">
                    <h2 class="h2 section-title">Frequently Asked Questions</h2>
                    <div class="faq-accordion">
                        <div class="faq-item">
                            <button class="faq-question" aria-expanded="false">
                                <span>How do I register for Job-Connect as a student?</span>
                                <i class="ri-arrow-down-s-line"></i>
                            </button>
                            <div class="faq-answer">
                                <p>You can register by visiting the <a href="/auth/register/student" class="inline-link">Student Registration page</a> and filling in your details. You'll need your UMP student number.</p>
                            </div>
                        </div>
                        <div class="faq-item">
                            <button class="faq-question" aria-expanded="false">
                                <span>I forgot my password. How can I reset it?</span>
                                <i class="ri-arrow-down-s-line"></i>
                            </button>
                            <div class="faq-answer">
                                <p>Currently, our platform does not have an automated password reset. Please contact <a href="mailto:jobconnect.support@ump.ac.za" class="inline-link">jobconnect.support@ump.ac.za</a> with your student/staff number for assistance.</p>
                            </div>
                        </div>
                        <div class="faq-item">
                            <button class="faq-question" aria-expanded="false">
                                <span>How long does it take for a department to respond to my job application?</span>
                                <i class="ri-arrow-down-s-line"></i>
                            </button>
                            <div class="faq-answer">
                                <p>Response times can vary depending on the department and the number of applications received. You can track the status of your application on the <a href="/applications/my" class="inline-link">My Applications</a> page. If a significant amount of time has passed after the application deadline, you might consider following up with the contact person listed in the job post, if available, or with UMP Career Services.</p>
                            </div>
                        </div>
                         <div class="faq-item">
                            <button class="faq-question" aria-expanded="false">
                                <span>Who can I contact for technical issues with the Job-Connect platform?</span>
                                <i class="ri-arrow-down-s-line"></i>
                            </button>
                            <div class="faq-answer">
                                <p>For any technical difficulties, such as login problems, errors on the site, or issues with submitting applications, please email our support team at <a href="mailto:jobconnect.support@ump.ac.za" class="inline-link">jobconnect.support@ump.ac.za</a>. Please include your student/staff number and a clear description of the issue, including any error messages you see.</p>
                            </div>
                        </div>
                         <div class="faq-item">
                            <button class="faq-question" aria-expanded="false">
                                <span>Are the jobs listed only for current UMP students?</span>
                                <i class="ri-arrow-down-s-line"></i>
                            </button>
                            <div class="faq-answer">
                                <p>Yes, Job-Connect is primarily designed for currently registered University of Mpumalanga students seeking on-campus employment opportunities. Eligibility criteria might be specified in individual job postings.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </article>
    </main>

    <!--
      - #FOOTER
    -->
    <footer class="footer">
        <div class="footer-top">
            <div class="container">
                <div class="footer-brand">
                    <a href="/" class="logo">
                        <ion-icon name="business-outline"></ion-icon> job-connect
                    </a>
                    <p class="footer-text">
                        Your central hub for on-campus employment at the University of Mpumalanga.
                    </p>
                </div>
                <ul class="footer-list">
                    <li><p class="footer-list-title">Company</p></li>
                    <li><a href="/AboutUs" class="footer-link"><ion-icon name="chevron-forward"></ion-icon><span class="span">About us</span></a></li>
                    <li><a href="/jobs" class="footer-link"><ion-icon name="chevron-forward"></ion-icon><span class="span">Job Listings</span></a></li>
                    <li><a href="/contactUs" class="footer-link"><ion-icon name="chevron-forward"></ion-icon><span class="span">Contact</span></a></li>
                </ul>
                <ul class="footer-list">
                    <li><p class="footer-list-title">Useful Links</p></li>
                    <li><a href="#" class="footer-link"><ion-icon name="chevron-forward"></ion-icon><span class="span">Terms of Services</span></a></li>
                    <li><a href="#" class="footer-link"><ion-icon name="chevron-forward"></ion-icon><span class="span">Privacy Policy</span></a></li>
                     <% if (locals.session && locals.session.userId) { %>
                        <li><a href="/auth/logout" class="footer-link"><ion-icon name="chevron-forward"></ion-icon><span class="span">Logout</span></a></li>
                    <% } else { %>
                        <li><a href="/auth/login" class="footer-link"><ion-icon name="chevron-forward"></ion-icon><span class="span">Login</span></a></li>
                    <% } %>
                </ul>
                <ul class="footer-list">
                    <li><p class="footer-list-title">Contact Details</p></li>
                    <li class="footer-item">
                        <ion-icon name="location-outline"></ion-icon>
                        <address class="address">
                            University of Mpumalanga,<br>
                            Mbombela Campus,<br>
                            Mpumalanga, South Africa
                        </address>
                    </li>
                    <li class="footer-item">
                        <ion-icon name="mail-outline"></ion-icon>
                        <a href="mailto:jobconnect.support@ump.ac.za" class="footer-link">jobconnect.support@ump.ac.za</a>
                    </li>
                    <li class="footer-item">
                        <ion-icon name="call-outline"></ion-icon>
                        <a href="tel:+27130020001" class="footer-link">+27 (13) 002 0001 (UMP Student Enquiries)</a>
                    </li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p class="copyright">
                    &copy; <%= new Date().getFullYear() %> job-connect. All Rights Reserved by UMP ICT Services.
                </p>
                <ul class="social-list">
                    <li><a href="#" class="social-link"><ion-icon name="logo-facebook"></ion-icon></a></li>
                    <li><a href="#" class="social-link"><ion-icon name="logo-instagram"></ion-icon></a></li>
                    <li><a href="#" class="social-link"><ion-icon name="logo-twitter"></ion-icon></a></li>
                    <li><a href="#" class="social-link"><ion-icon name="logo-linkedin"></ion-icon></a></li>
                </ul>
            </div>
        </div>
    </footer>

    <!--
      - #BACK TO TOP
    -->
    <a href="#top" class="back-top-btn" aria-label="back to top" data-back-top-btn>
        <ion-icon name="arrow-up" aria-hidden="true"></ion-icon>
    </a>

    <!--
      - custom js link
    -->
    <script src="/js/script.js" defer></script>
    <script src="/js/contact.js" defer></script> <!--
      - ionicon link
    -->
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>

</body>
</html>
