<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transcript Analyzer</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }
        .header p {
            font-size: 1.2em;
            opacity: 0.9;
        }
        .upload-container {
            padding: 40px;
            text-align: center;
            border-bottom: 1px solid #eee;
        }
        .upload-area {
            border: 3px dashed #3498db;
            border-radius: 10px;
            padding: 60px 40px;
            margin: 20px 0;
            background: #f8f9fa;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .upload-area:hover {
            border-color: #2980b9;
            background: #e8f4fc;
        }
        .upload-area.dragover {
            border-color: #2980b9;
            background: #d4edfa;
        }
        .upload-icon {
            font-size: 4em;
            color: #3498db;
            margin-bottom: 20px;
        }
        .file-input {
            display: none;
        }
        .browse-btn {
            background: #3498db;
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1.1em;
            margin: 10px;
            transition: background 0.3s ease;
        }
        .browse-btn:hover {
            background: #2980b9;
        }
        .analyze-btn {
            background: #27ae60;
            color: white;
            padding: 15px 40px;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            font-size: 1.2em;
            margin: 20px 0;
            transition: background 0.3s ease;
        }
        .analyze-btn:hover:not(:disabled) {
            background: #219a52;
        }
        .analyze-btn:disabled {
            background: #95a5a6;
            cursor: not-allowed;
        }
        .loading {
            text-align: center;
            padding: 40px;
        }
        .spinner {
            border: 5px solid #f3f3f3;
            border-top: 5px solid #3498db;
            border-radius: 50%;
            width: 60px;
            height: 60px;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .results {
            padding: 30px;
            display: none;
        }
        .student-info {
            background: #f8f9fa;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 30px;
            border-left: 5px solid #3498db;
        }
        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .summary-card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            text-align: center;
            border-top: 4px solid #3498db;
        }
        .summary-card h3 {
            color: #2c3e50;
            margin-bottom: 15px;
            font-size: 1.1em;
        }
        .summary-card .value {
            font-size: 2.5em;
            font-weight: bold;
            color: #3498db;
            margin: 10px 0;
        }
        .summary-card .label {
            color: #7f8c8d;
            font-size: 0.9em;
        }
        .distinction-card {
            border-top-color: #27ae60;
        }
        .distinction-card .value {
            color: #27ae60;
        }
        .warning-card {
            border-top-color: #e74c3c;
        }
        .warning-card .value {
            color: #e74c3c;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ecf0f1;
        }
        th {
            background: #34495e;
            color: white;
            font-weight: 600;
        }
        tr:hover {
            background: #f8f9fa;
        }
        .distinction {
            background: #d5f4e6 !important;
            border-left: 4px solid #27ae60;
        }
        .fail {
            background: #fdeaea !important;
            border-left: 4px solid #e74c3c;
        }
        .error {
            background: #fdeaea;
            color: #c0392b;
            padding: 20px;
            border-radius: 10px;
            margin: 20px 0;
            border-left: 5px solid #e74c3c;
        }
        .file-info {
            background: #e8f4fc;
            padding: 15px;
            border-radius: 8px;
            margin: 15px 0;
            display: none;
        }
        .debug-link {
            text-align: center;
            margin-top: 20px;
        }
        .debug-link a {
            color: #7f8c8d;
            text-decoration: none;
            font-size: 0.9em;
        }
        .debug-link a:hover {
            color: #3498db;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🎓 Academic Transcript Analyzer</h1>
            <p>Upload your University of Mpumalanga transcript for detailed analysis</p>
        </div>
        
        <div class="upload-container">
            <div class="upload-area" id="uploadArea">
                <div class="upload-icon">📄</div>
                <h2>Upload Your Transcript PDF</h2>
                <p>Drag and drop your academic transcript PDF file here, or click to browse</p>
                <input type="file" id="transcriptFile" class="file-input" accept=".pdf">
                <button class="browse-btn" onclick="document.getElementById('transcriptFile').click()">
                    Browse Files
                </button>
            </div>
            
            <div class="file-info" id="fileInfo"></div>
            
            <button class="analyze-btn" id="analyzeBtn" disabled>Analyze Transcript</button>
            
            <div class="debug-link">
                <a href="#" id="debugLink">Having issues? Debug PDF parsing</a>
            </div>
        </div>

        <div id="loading" class="loading" style="display: none;">
            <div class="spinner"></div>
            <h3>Analyzing Transcript...</h3>
            <p>Processing your academic record. This may take a few seconds.</p>
        </div>

        <div id="results" class="results"></div>
    </div>

    <script>
        const uploadArea = document.getElementById('uploadArea');
        const fileInput = document.getElementById('transcriptFile');
        const analyzeBtn = document.getElementById('analyzeBtn');
        const fileInfo = document.getElementById('fileInfo');
        const debugLink = document.getElementById('debugLink');
        let currentFile = null;

        // Drag and drop functionality
        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        ['dragenter', 'dragover'].forEach(eventName => {
            uploadArea.addEventListener(eventName, () => uploadArea.classList.add('dragover'), false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            uploadArea.addEventListener(eventName, () => uploadArea.classList.remove('dragover'), false);
        });

        uploadArea.addEventListener('drop', handleDrop, false);
        uploadArea.addEventListener('click', () => fileInput.click(), false);

        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            handleFiles(files);
        }

        fileInput.addEventListener('change', function() {
            handleFiles(this.files);
        });

        function handleFiles(files) {
            if (files.length > 0) {
                const file = files[0];
                if (file.type === 'application/pdf') {
                    currentFile = file;
                    fileInfo.innerHTML = `
                        <strong>Selected file:</strong> ${file.name}<br>
                        <strong>Size:</strong> ${(file.size / 1024 / 1024).toFixed(2)} MB<br>
                        <strong>Type:</strong> ${file.type}
                    `;
                    fileInfo.style.display = 'block';
                    analyzeBtn.disabled = false;
                } else {
                    alert('Please select a PDF file.');
                }
            }
        }

        // Analyze transcript
        analyzeBtn.addEventListener('click', async () => {
            if (!currentFile) return;

            const formData = new FormData();
            formData.append('transcript', currentFile);
            
            const loading = document.getElementById('loading');
            const results = document.getElementById('results');
            
            loading.style.display = 'block';
            results.style.display = 'none';
            analyzeBtn.disabled = true;
            analyzeBtn.textContent = 'Analyzing...';
            
            try {
                const response = await fetch('/analyze-transcript', {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                
                if (response.ok) {
                    displayResults(data);
                } else {
                    throw new Error(data.error || data.details || 'Analysis failed');
                }
            } catch (error) {
                results.innerHTML = `
                    <div class="error">
                        <h3>Analysis Error</h3>
                        <p>${error.message}</p>
                        <p>Please ensure you're uploading a valid University of Mpumalanga academic transcript PDF.</p>
                    </div>
                `;
                results.style.display = 'block';
            } finally {
                loading.style.display = 'none';
                analyzeBtn.disabled = false;
                analyzeBtn.textContent = 'Analyze Transcript';
            }
        });

        // Debug functionality
        debugLink.addEventListener('click', async (e) => {
            e.preventDefault();
            if (!currentFile) {
                alert('Please select a file first.');
                return;
            }

            const formData = new FormData();
            formData.append('transcript', currentFile);
            
            try {
                const response = await fetch('/debug-pdf', {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();
                console.log('PDF Debug Info:', data);
                alert('PDF debug information logged to console. Check browser developer tools.');
            } catch (error) {
                alert('Debug failed: ' + error.message);
            }
        });

        function displayResults(data) {
            const records = data.academicRecord || [];
            const summary = data.summary || {};
            
            let html = `
                <div class="student-info">
                    <h2>👤 Student Information</h2>
                    <p><strong>Name:</strong> ${data.studentInfo?.name || 'N/A'}</p>
                    <p><strong>Student Number:</strong> ${data.studentInfo?.studentNumber || 'N/A'}</p>
                    <p><strong>Program:</strong> ${data.studentInfo?.program || 'N/A'}</p>
                    <p><strong>Years:</strong> ${(data.studentInfo?.years || []).join(', ')}</p>
                </div>
                
                <div class="summary-cards">
                    <div class="summary-card">
                        <h3>📊 Average Mark</h3>
                        <div class="value">${summary.averageMark?.toFixed(1) || '0.0'}%</div>
                        <div class="label">Overall Performance</div>
                    </div>
                    <div class="summary-card distinction-card">
                        <h3>🏆 Distinctions</h3>
                        <div class="value">${summary.distinctionCount || 0}</div>
                        <div class="label">Excellent Grades</div>
                    </div>
                    <div class="summary-card">
                        <h3>📚 Total Credits</h3>
                        <div class="value">${summary.totalCredits || 0}</div>
                        <div class="label">Accumulated Credits</div>
                    </div>
                    <div class="summary-card ${summary.failedCourses?.length > 0 ? 'warning-card' : ''}">
                        <h3>⚠️ Failed Courses</h3>
                        <div class="value">${summary.failedCourses?.length || 0}</div>
                        <div class="label">Need Attention</div>
                    </div>
                </div>
            `;

            if (summary.failedCourses && summary.failedCourses.length > 0) {
                html += `
                    <div class="error">
                        <h3>Failed Courses</h3>
                        <p>${summary.failedCourses.join(', ')}</p>
                    </div>
                `;
            }

            html += `
                <h2>📖 Academic Record</h2>
                <table>
                    <thead>
                        <tr>
                            <th>Year</th>
                            <th>Semester</th>
                            <th>Course</th>
                            <th>Mark</th>
                            <th>Grade</th>
                            <th>Credits</th>
                        </tr>
                    </thead>
                    <tbody>
            `;
            
            records.forEach(record => {
                const rowClass = record.grade && record.grade.includes('DISTINCTION') ? 'distinction' : 
                               (record.mark < 50 || record.grade?.includes('FAIL')) ? 'fail' : '';
                html += `
                    <tr class="${rowClass}">
                        <td>${record.year || 'N/A'}</td>
                        <td>${record.semester || 'N/A'}</td>
                        <td>${record.course || 'N/A'}</td>
                        <td>${record.mark || 'N/A'}</td>
                        <td>${record.grade || 'N/A'}</td>
                        <td>${record.credits || 'N/A'}</td>
                    </tr>
                `;
            });
            
            html += `
                    </tbody>
                </table>
                <p><em>Showing ${records.length} course records</em></p>
            `;
            
            document.getElementById('results').innerHTML = html;
            document.getElementById('results').style.display = 'block';
            
            // Scroll to results
            document.getElementById('results').scrollIntoView({ behavior: 'smooth' });
        }
    </script>
</body>
</html>