<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - UMP Job Connect</title>
    <link rel="stylesheet" href="/css/Home.css">
    <link rel="stylesheet" href="/home/assets/css/style.css">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body id="top" class="bg-gray-100">
    
    <main style="margin-top: 6em;">
        <header class="header" data-header>
        <div class="container">
            <a href="/" class="logo">
                <ion-icon name="business-outline"></ion-icon> job-connect
            </a>
            <nav class="navbar container" data-navbar>
                <ul class="navbar-list">
                    <li><a href="/" class="navbar-link" data-nav-link>Home</a></li>
                    <li><a href="/AboutUs" class="navbar-link" data-nav-link style="color: hsl(194, 100%, 28%);">About Us</a></li>
                    <li><a href="/contactUs" class="navbar-link" data-nav-link>Contact Us</a></li>
                    <li><a href="/jobs" class="navbar-link" data-nav-link>Jobs</a></li>
                    <% if (locals.session && locals.session.role) { %>
                        <% if (locals.session.role === 'student') { %>
                            <li><a href="/applications/my" class="navbar-link" data-nav-link>My Applications</a></li>
                            <li><a href="/student/profile" class="navbar-link" data-nav-link>Profile</a></li>
                        <% } else if (locals.session.role === 'admin') { %>
                            <li><a href="/admin/jobs" class="navbar-link" data-nav-link>My Postings</a></li>
                            <li><a href="/admin/jobs/new" class="navbar-link" data-nav-link>Post New Job</a></li>
                        <% } %>
                    <% } %>
                </ul>
            </nav>
            <% if (locals.session && locals.session.userId) { %>
                <a href="/auth/logout" class="btn btn-secondary">Logout</a>
            <% } else { %>
                <a class="btn btn-secondary" href="/auth/login">Login</a>
            <% } %>
            <button class="nav-toggle-btn" aria-label="Toggle menu" data-nav-toggler>
                <ion-icon name="menu-outline" aria-hidden="true" class="menu-icon"></ion-icon>
                <ion-icon name="close-outline" aria-hidden="true" class="close-icon"></ion-icon>
            </button>
        </div>
    </header>
        <section class="section profile-section py-10">
            <div class="container mx-auto px-4">
                <h1 class="text-3xl font-bold mb-6">My Profile</h1>
                <% if (error) { %>
                    <div class="bg-red-100 text-red-700 p-4 rounded mb-4">
                        <%= error %>
                    </div>
                <% } %>
                <% if (message) { %>
                    <div class="bg-green-100 text-green-700 p-4 rounded mb-4">
                        <%= message %>
                    </div>
                <% } %>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Main Profile Info -->
                    <div class="md:col-span-2 bg-white p-6 rounded-lg shadow">
                        <h2 class="text-2xl font-semibold mb-4">Personal Information</h2>
                        <div class="space-y-4">
                            <p><strong>Name:</strong> <%= student.name %></p>
                            <p><strong>Email:</strong> <%= student.email %></p>
                            <p><strong>Student Number:</strong> <%= student.student_number %></p>
                            <p><strong>Joined:</strong> <%= new Date(student.created_at).toLocaleDateString() %></p>
                            <% if (appDetails.cellular_phone) { %>
                                <p><strong>Phone:</strong> <%= appDetails.cellular_phone %></p>
                            <% } %>
                            <% if (appDetails.identity_number) { %>
                                <p><strong>Identity Number:</strong> <%= appDetails.identity_number %></p>
                            <% } %>
                            <% if (appDetails.postal_address) { %>
                                <p><strong>Postal Address:</strong> <%= appDetails.postal_address %>, <%= appDetails.postal_code || 'N/A' %></p>
                            <% } %>
                            <% if (appDetails.residential_address) { %>
                                <p><strong>Residential Address:</strong> <%= appDetails.residential_address %>, <%= appDetails.residential_code || 'N/A' %></p>
                            <% } %>
                        </div>
                        <a href="/student/profile/edit" class="mt-4 inline-block bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">Edit Profile</a>
                    </div>
                    <!-- Application Summary -->
                    <div class="bg-white p-6 rounded-lg shadow">
                        <h2 class="text-2xl font-semibold mb-4">Application Summary</h2>
                        <% if (appSummary.length > 0) { %>
                            <ul class="space-y-2">
                                <% appSummary.forEach(summary => { %>
                                    <li><strong><%= summary.status %>:</strong> <%= summary.count %> application(s)</li>
                                <% }) %>
                            </ul>
                            <a href="/applications/my" class="mt-4 inline-block bg-gray-500 text-white px-4 py-2 rounded hover:bg-gray-600">View All Applications</a>
                        <% } else { %>
                            <p>No applications submitted yet.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <%- include('../partials/footer') %>
    <a href="#top" class="back-top-btn fixed bottom-4 right-4 bg-blue-500 text-white p-2 rounded-full" aria-label="back to top">
        <ion-icon name="arrow-up" aria-hidden="true"></ion-icon>
    </a>
    <script src="/home/assets/js/script.js" defer></script>
    <script type="module" src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"></script>
</body>
</html>